# Loom daemon environment variables
# Copy this file to .env and adjust values for your environment

# Path where the daemon stores session manifests, CAS blobs, and logs
LOOM_DATA_ROOT=~/.local/share/loom

# Unix socket path used by loom-cli and loom-mcp to connect to the daemon
LOOM_SOCKET_PATH=~/.local/share/loom/loom.sock

# Path for the daemon's structured log output (JSON lines)
LOOM_LOG_PATH=~/.local/share/loom/daemon.log

# Enable OpenTelemetry trace export (requires OTEL_EXPORTER_OTLP_ENDPOINT)
LOOM_OTEL_ENABLED=false

# OpenTelemetry endpoint (only required when LOOM_OTEL_ENABLED=true)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
