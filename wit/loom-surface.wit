// Loom WASM surface ABI. wit-bindgen consumes this file to generate
// host bindings (loom-host) and guest bindings (loom-surface-web).

package loom:surface@1.0.0;

interface types {
    record action {
        kind: string,
        payload: list<u8>,
        deadline-ms: u64,
    }

    record receipt {
        action-hash: string,
        outcome-hash: string,
        emitted-at-ms: u64,
        // Navigate-tier optional fields.
        url: option<string>,
        final-url: option<string>,
        title: option<string>,
        status-code: option<u32>,
        dom-snapshot-hash: option<string>,
        screenshot-after-hash: option<string>,
        // Interaction-tier (capture-policy=fingerprint) post-action DOM
        // fingerprint: sha256 of the normalized DOM.getDocument response captured
        // AFTER a DOM-mutating selector verb (click/type/select/hover). Content-
        // bearing and IN the manifest hash chain (presence-gated on the tier),
        // unlike the per-verb-constant `outcome-hash`. Absent under
        // default/minimal/full. The host is authoritative: it only accepts this
        // field into the canonical receipt under the fingerprint tier.
        dom-after-hash: option<string>,
        console-count: option<u64>,
        network-count: option<u64>,
        // JSON-serialized Vec<LoomNetworkEvent>.
        side-effects-json: option<list<u8>>,
        // JSON-serialized Vec<ShimConsoleLine> {level, message}; surfaces
        // as `console_lines` on the wire receipt.
        console-lines-json: option<list<u8>>,
        // JSON-serialized NetworkSummary {total_count, total_bytes, error_count}.
        network-summary-json: option<list<u8>>,
        // Observational per-request network entries (NOT in the replay hash
        // chain). JSON-serialized Vec<LoomNetworkEntry>. Inline-XOR-blob
        // discriminator, mirroring return-value-*: network-entries-blob-ref
        // is_some() ↔ serialized list ≥ 64KB (offloaded to content store) and
        // network-entries-json is None. network-entries-truncated = the list
        // is incomplete (shim cap hit, host cap clamp, OR a content-store
        // offload failure that dropped the list — in the last case both
        // json and blob-ref are None).
        network-entries-json: option<list<u8>>,
        network-entries-blob-ref: option<content-ref>,
        network-entries-truncated: option<bool>,
        // Evaluate-tier optional fields. Truncation discriminator:
        // return-value-blob-ref.is_some() ↔ value > 64KB and offloaded to
        // the content store.
        return-value-json: option<string>,
        return-value-blob-ref: option<content-ref>,
        // v0.9.6 web-cookie-injection cookie-result fields. Each is a
        // JSON-encoded payload (the guest wraps in Vec<u8> on emit;
        // the host's decode_typed_receipt re-parses for shape).
        //   set-cookies-result:  Vec<SetCookieResult>
        //   get-cookies-result:  Vec<NetworkCookie> (raw values per D7
        //                        — receipt operator-facing; structured
        //                        logs scrub via mcp_observability §6)
        //   clear-cookies-result: ClearCookiesResult {cleared_count}
        //   delete-cookies-result: DeleteCookiesResult {name, matched}
        // D13 tuple-identity sort (by name,domain,path UTF-16 lex)
        // is applied host-side in ReceiptMarshaller before JCS-encoding
        // canonical bytes so byte-identity holds across record/replay.
        set-cookies-result: option<string>,
        get-cookies-result: option<string>,
        clear-cookies-result: option<string>,
        delete-cookies-result: option<string>,
        // settle-capture readiness fields (navigate-tier).
        settle-until: option<string>,
        settle-outcome: option<string>,
        settle-ms: option<u64>,
        network-count-at-settle: option<u64>,
    }

    /// Result returned by the navigate-execute host function.
    record navigate-result {
        url: string,
        final-url: string,
        title: string,
        status-code: u32,
        /// SHA-256 hex of the DOM snapshot blob stored in ContentStore.
        dom-snapshot-hash: string,
        /// SHA-256 hex of the screenshot blob stored in ContentStore.
        screenshot-after-hash: string,
        /// Stub: always 0 (real shim console-capture is future work).
        console-count: u64,
        network-count: u64,
        /// UTF-8 JSON bytes of Vec<LoomNetworkEvent>.
        side-effects-json: list<u8>,
        /// Session-monotonic ms timestamp from DeterminismHarness.
        emitted-at-ms: u64,
        /// UTF-8 JSON bytes of Vec<ShimConsoleLine>. Empty list today
        /// (real shim console-capture is future work).
        console-lines-json: list<u8>,
        /// UTF-8 JSON bytes of loom_core NetworkSummary
        /// {total_count, total_bytes, error_count}.
        network-summary-json: list<u8>,
        /// Observational per-request network entries (NOT hash-chained).
        /// Inline UTF-8 JSON bytes of Vec<LoomNetworkEntry>; None when
        /// offloaded (≥64KB → network-entries-blob-ref) OR when an offload
        /// failure dropped the list (then blob-ref is None too).
        network-entries-json: option<list<u8>>,
        /// ContentRef to the JSON bytes when ≥64KB. None when inline or dropped.
        network-entries-blob-ref: option<content-ref>,
        /// The entries list is incomplete (cap hit or offload failure).
        network-entries-truncated: bool,
        /// settle-capture: readiness mode the capture was gated on.
        settle-until: string,
        /// settle-capture: how the readiness wait ended
        /// (`reached|timeout|dom_unstable`).
        settle-outcome: string,
        /// settle-capture: virtual-tick count mapped to ms. Diagnostic only —
        /// excluded from outcome_hash.
        settle-ms: u64,
        /// settle-capture: in-flight (non-WS/SSE) request count at settle.
        network-count-at-settle: u64,
    }

    /// Result returned by the evaluate-execute host function. Exactly one
    /// of return-value-json / return-value-blob-ref is Some on success.
    /// Exception path returns Err(host-error::shim-failure(detail-json)) —
    /// see host_impl.rs::evaluate_execute for the detail-json shape.
    record evaluate-result {
        /// Canonical-JSON of the evaluated value. None when value > 64KB
        /// (offloaded to content store; see return-value-blob-ref).
        return-value-json: option<string>,
        /// ContentRef to canonical-JSON bytes when value > 64KB. None when
        /// the value fits inline. Truncation discriminator = is_some().
        return-value-blob-ref: option<content-ref>,
        /// Session-monotonic ms timestamp (DeterminismHarness).
        emitted-at-ms: u64,
    }

    /// Result returned by the set-input-files-execute host function.
    /// Minimal — the guest computes action_hash + emitted_at_ms itself
    /// (clock-now) and derives outcome_hash from file-count + selector.
    record set-input-files-result {
        /// Number of files set on the input element.
        file-count: u32,
    }

    /// Result returned by the wait-for-execute host function (settle-capture
    /// slice 2). A readiness wait on the CURRENT page — no navigation, no DOM /
    /// screenshot capture. Carries only the settle verdict.
    record wait-result {
        /// Readiness mode that was waited for (load|networkidle|settled).
        settle-until: string,
        /// How the wait ended (reached|timeout|dom_unstable).
        settle-outcome: string,
        /// Virtual-tick count mapped to ms. Diagnostic only — excluded from
        /// outcome_hash (like the screenshot hash is excluded from the chain).
        settle-ms: u64,
        /// In-flight (non-WS/SSE) request count at settle.
        network-count-at-settle: u64,
        /// Session-monotonic ms timestamp (DeterminismHarness).
        emitted-at-ms: u64,
    }

    record content-ref {
        sha256: string,
        size: u64,
    }

    record instant {
        epoch-ms: u64,
    }

    variant host-error {
        budget-exceeded(string),
        vault-rejection(string),
        shim-failure(string),
        store-integrity-failed(string),
        internal(string),
    }

    record net-req {
        method: string,
        url: string,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    record net-resp {
        status: u16,
        headers: list<tuple<string, string>>,
        body: list<u8>,
    }

    enum log-level { trace, debug, info, warn, error }
}

interface host {
    use types.{action, receipt, content-ref, instant, host-error,
               net-req, net-resp, log-level, navigate-result, evaluate-result,
               set-input-files-result, wait-result};

    // Determinism sources
    clock-now: func() -> instant;
    rng-next-u64: func() -> u64;

    // Content store (records side-effect tape)
    blob-put: func(bytes: list<u8>) -> result<content-ref, host-error>;
    blob-get: func(ref: content-ref) -> result<list<u8>, host-error>;

    // Record-screenshot: decode a CDP `Page.captureScreenshot` response
    // (`cdp-response` = the CBOR `{data: <base64-PNG>}` returned by shim-call)
    // into RAW PNG bytes and store them in the content store, returning the
    // content-ref of the decoded image. The WASM guest ships without a CBOR /
    // base64 decoder by design, so the host owns the unwrap; this is what makes
    // `web.screenshot`'s screenshot-after-hash resolve to a renderable image.
    record-screenshot: func(cdp-response: list<u8>) -> result<content-ref, host-error>;

    // Network (vault-mediated; secrets never enter WASM linear memory)
    net-request: func(req: net-req) -> result<net-resp, host-error>;

    // Bridge to out-of-process shim
    shim-call: func(shim-id: string, msg: list<u8>) -> result<list<u8>, host-error>;

    // Navigate-execute: typed replacement for shim-call on the navigate path.
    // Host handles ShimManager::send_navigate + ContentStore.put; returns
    // a typed navigate-result.
    // action-id propagates the WASM-guest-computed action_hash (= sha256 of
    // action.payload) for receipt correlation in the host.
    // `until` (settle-capture) is the readiness mode the capture is gated on
    // (`load|networkidle|settled`); the host forwards it to the shim.
    navigate-execute: func(action-id: string, url: string, until: string, budget-ms: u64) -> result<navigate-result, host-error>;

    // Evaluate-execute: typed replacement for shim-call on the web.evaluate
    // path. Host handles ShimManager::send_evaluate, CDP Runtime.evaluate
    // dispatch, exceptionDetails handling (→ shim-failure), CBOR→canonical-JSON
    // conversion, and 64KB content-store offload.
    evaluate-execute: func(action-id: string, expression: string, budget-ms: u64) -> result<evaluate-result, host-error>;

    // Set-input-files-execute: typed host function for web.set_input_files.
    // `payload` is the daemon-built canonical JSON `{"selector":..,"paths":[..]}`
    // (the guest forwards a.payload verbatim — it has no JSON parser, and the
    // host owns the logic). The host parses it, resolves the selector
    // (DOM.getDocument → DOM.querySelector; nodeId==0 → shim-failure
    // kind=selector_not_found), and issues DOM.setFileInputFiles{nodeId, files}
    // (error on a resolved node → shim-failure kind=not_a_file_input). Paths are
    // already validated + canonicalized daemon-side (upload_guard).
    set-input-files-execute: func(action-id: string, payload: list<u8>, budget-ms: u64) -> result<set-input-files-result, host-error>;

    // Wait-for-execute: typed readiness wait on the CURRENT page (settle-capture
    // slice 2). Runs the shim-side SettleDriver/ReadinessMonitor WITHOUT
    // navigating or capturing DOM/screenshot. `until` is the readiness mode
    // (`load|networkidle|settled`); the host forwards it to the shim's
    // wait-for path, which reuses the exact verdict logic the navigate gate
    // uses. Returns a typed wait-result with the settle verdict.
    wait-for-execute: func(action-id: string, until: string, budget-ms: u64) -> result<wait-result, host-error>;

    // Vault-substitute-cookies: v0.9.6 web-cookie-injection grant
    // resolution. Wraps `Vault::substitute_cookies(grant, session)`
    // (shipped v0.9.5). Returns the keychain blob bytes — JSON of shape
    // `{"schema_version":1, "cookies":[NetworkCookieParam, ...]}`. The
    // WASM guest deserialises into Vec<NetworkCookieParam>, validates,
    // and dispatches CDP Network.setCookies.
    //
    // This is the chokepoint where raw cookie values briefly cross
    // into the WASM guest's linear memory. The host-side implementation
    // uses Zeroizing<Vec<u8>> to ensure heap wipe on drop within daemon
    // memory (D12 / §10).
    //
    // Rejection paths: VaultGrantExpired, VaultGrantRevoked,
    // VaultScopeViolation (grant credential_type != Cookie),
    // VaultOriginViolation (session_id mismatch — D5 / FND-0008).
    vault-substitute-cookies: func(grant-id: string, session-id: string) -> result<list<u8>, host-error>;

    // Capture-dom-after-hash (capture-policy=fingerprint): post-action DOM
    // fingerprint for DOM-mutating selector interactions. Returns Some(sha256-hex
    // of the normalized DOM.getDocument response) ONLY when the session's
    // capture-policy is `fingerprint`; None otherwise (so the extra DOM.getDocument
    // round-trip is opt-in). The host issues DOM.getDocument via the shim, which
    // already normalizes the response through `normalize_dom_cbor` (frameId-stripped
    // → deterministic + content-bearing), and hashes it — the SAME computation
    // `web.snapshot` uses. Captures the synchronous post-action DOM (no async settle
    // wait). Record-only: returns None in replay (the shim is not driven in replay).
    capture-dom-after-hash: func() -> result<option<string>, host-error>;

    // Logging + receipt emission
    log-emit: func(level: log-level, msg: string,
                   fields: list<tuple<string, string>>);
    receipt-emit: func(r: receipt);
}

interface web-surface {
    use types.{action, receipt, host-error};
    navigate:       func(a: action) -> result<receipt, host-error>;
    click:          func(a: action) -> result<receipt, host-error>;
    type-text:      func(a: action) -> result<receipt, host-error>;
    select:         func(a: action) -> result<receipt, host-error>;
    hover:          func(a: action) -> result<receipt, host-error>;
    scroll:         func(a: action) -> result<receipt, host-error>;
    wait:           func(a: action) -> result<receipt, host-error>;
    // settle-capture slice 2: standalone readiness wait on the current page.
    wait-for:       func(a: action) -> result<receipt, host-error>;
    evaluate:       func(a: action) -> result<receipt, host-error>;
    set-input-files: func(a: action) -> result<receipt, host-error>;
    screenshot:     func(a: action) -> result<receipt, host-error>;
    snapshot:       func(a: action) -> result<receipt, host-error>;
    // v0.9.6 web-cookie-injection.
    set-cookies:    func(a: action) -> result<receipt, host-error>;
    get-cookies:    func(a: action) -> result<receipt, host-error>;
    clear-cookies:  func(a: action) -> result<receipt, host-error>;
    delete-cookies: func(a: action) -> result<receipt, host-error>;
}

// v1.5 surfaces — WIT defined, WASM not built at v1
interface shell-surface {
    use types.{action, receipt, host-error};
    exec: func(a: action) -> result<receipt, host-error>;
}

interface fs-surface {
    use types.{action, receipt, host-error};
    snapshot: func(a: action) -> result<receipt, host-error>;
}

interface api-surface {
    use types.{action, receipt, host-error};
    request: func(a: action) -> result<receipt, host-error>;
}

interface native-surface {
    use types.{action, receipt, host-error};
    ax-query: func(a: action) -> result<receipt, host-error>;
}

world surface {
    import host;
    export web-surface;
    // v1.5: also export shell-surface, fs-surface, api-surface, native-surface
}
